{
  "name": "edgepulse",
  "version": "1.0.0",
  "description": "Native Serverless Online Monitoring & Status Page for EdgeOne Makers",
  "framework": "static",
  "routes": [
    {
      "src": "^/api/cron$",
      "dest": "/cloud-functions/api/cron"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/functions/api/$1"
    },
    {
      "src": "^/admin/?$",
      "dest": "/admin.html"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    }
  ]
}
