{
  "name": "edgepulse",
  "version": "1.0.0",
  "description": "Native Serverless Online Monitoring & Status Page System for EdgeOne Makers",
  "framework": "static",
  "routes": [
    {
      "src": "^/api/auth/(.*)$",
      "dest": "/functions/api/auth"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/functions/api/$1"
    },
    {
      "src": "^/admin$",
      "dest": "/admin.html"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    }
  ]
}
